# SEO Autopilot Environment Variables
# Copy to .env and fill in your values

# ===========================================
# AI API Keys (at least one required)
# ===========================================

# OpenAI API
OPENAI_API_KEY=sk-...

# Anthropic Claude API (if using Claude for agents)
# ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# Supabase (required for data persistence)
# ===========================================
# Get from: https://supabase.com/dashboard/project/_/settings/api

# Project URL (use VITE_ prefix for frontend access)
VITE_SUPABASE_URL=https://xxx.supabase.co

# Public/Anon key (safe for frontend)
VITE_SUPABASE_ANON_KEY=eyJ...

# Service/Admin key (server-side only, never expose to frontend)
SUPABASE_SERVICE_KEY=eyJ...

# JWT Secret (for custom JWT verification)
SUPABASE_JWT_SECRET=...

# Access Token (for Supabase CLI - get from supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=sbp_...

# ===========================================
# Optional: SERP APIs (for rank tracking)
# ===========================================

# SerpAPI (for Google SERP data)
# Get from: https://serpapi.com/
# SERPAPI_KEY=...

# ===========================================
# Optional: Google APIs
# ===========================================

# Google Search Console API
# OAuth credentials from Google Cloud Console
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# ===========================================
# Email Notifications (Resend)
# ===========================================
# Get from: https://resend.com/api-keys
# Required for: audit completion emails, weekly reports
RESEND_API_KEY=re_...
