{
  "name": "rankcli",
  "version": "0.0.1",
  "private": true,
  "description": "Ship code, get ranked. SEO meets CI/CD.",
  "homepage": "https://rankcli.dev",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "cli": "pnpm --filter @rankcli/cli",
    "saas": "pnpm --filter @rankcli/saas",
    "agent": "pnpm --filter @rankcli/agent-runtime"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "keywords": [
    "seo",
    "ci-cd",
    "cli",
    "developer-tools",
    "engineering-as-marketing",
    "ai",
    "github-actions"
  ],
  "author": "Brian Sam-Bodden",
  "license": "MIT"
}
