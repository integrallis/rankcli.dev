# =============================================================================
# RankCLI Development Environment Variables
# =============================================================================
# Copy this file to .env in the project root and fill in your values.
# See DEPLOYMENT.md for setup instructions.

# =============================================================================
# Supabase (Required)
# =============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_ACCESS_TOKEN=your_supabase_access_token

# =============================================================================
# Stripe (Required for payments)
# =============================================================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# =============================================================================
# Cloudflare Web Analytics (Optional - cookieless page views)
# =============================================================================
# Site token from Cloudflare dashboard > Web Analytics. Unset: no beacon is
# built into the site. In CI it comes from the CF_BEACON_TOKEN repo variable.
VITE_CF_BEACON_TOKEN=

# Reddit Ads conversion pixel (Ads Manager > Events Manager > create pixel).
# Reddit requires a conversion_pixel_id on every ad group, so no pixel means no
# campaigns. Unset: no advertising tracker ships at all. In CI it comes from the
# REDDIT_PIXEL_ID repo variable. Turning this on makes the Cookies section of
# PrivacyPage true - do not set it without that copy being live.
VITE_REDDIT_PIXEL_ID=

# =============================================================================
# OpenAI (Optional - for AI features)
# =============================================================================
OPENAI_API_KEY=sk-proj-xxx

# =============================================================================
# GitHub App (Optional - for GitHub integration)
# =============================================================================
# Create a GitHub App at: https://github.com/settings/apps/new
GITHUB_APP_ID=123456
GITHUB_APP_NAME=rankcli-dev
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
# Private key (base64 encoded): cat private-key.pem | base64
GITHUB_PRIVATE_KEY=LS0tLS1CRUdJTi...

# Frontend GitHub App URL (for Connect GitHub button)
VITE_GITHUB_APP_URL=https://github.com/apps/rankcli-dev

# =============================================================================
# Notes
# =============================================================================
# - VITE_* variables are exposed to the frontend
# - Non-VITE variables are used by CLI, scripts, and Edge Functions
# - For production, use separate Supabase project and Stripe live keys
# - OAuth is configured in Supabase Dashboard > Authentication > Providers
